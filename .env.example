# Copy to .env and fill in (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=
# ARIADNE_PORT=3100
# ARIADNE_FEDERATION=off
# ARIADNE_RELAY=off          # off | server | client
# ARIADNE_FEDERATION_PORT=3101
# ARIADNE_FEDERATION_LISTEN=off
# ARIADNE_PUBLIC_URL=https://ariadne.example.com
# ARIADNE_LAN_URL=ws://10.1.1.5:3100/p2p
# ARIADNE_PEER_KEY_FILE=secrets/peer_key
# Tunnel token from Cloudflare Zero Trust. The hostname's service URL is http://app:3100.
CLOUDFLARE_TUNNEL_TOKEN=
