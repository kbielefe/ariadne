# Ariadne server (web UI + API + MCP) on http://127.0.0.1:3100.
# Remote access: cloudflared + Cloudflare Access (docs/CLOUDFLARE.md).
# Image is built by hand (needs the VPN): podman build -t localhost/ariadne2:0.3.0 .
[Unit]
Description=Ariadne server
Requires=ariadne-postgres.service
After=ariadne-postgres.service

[Container]
ContainerName=ariadne
Image=localhost/ariadne2:0.3.0
Pull=never
Environment=ARIADNE_LISTEN_HOST=0.0.0.0 ARIADNE_LISTEN_PORT=3100
Environment=ARIADNE_ALLOWED_HOSTS=127.0.0.1:3100,localhost:3100,ariadne.bielefeldt.dev
Environment=ARIADNE_TRUST_PROXY=1
Environment=LOG_LEVEL=info
Secret=ariadne-database-url,type=env,target=DATABASE_URL
# Map you to the image's node user.
UserNS=keep-id:uid=1000,gid=1000
PublishPort=127.0.0.1:3100:3100
Network=ariadne-frontend.network
Network=ariadne-backend.network
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3100/health/ready
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always

[Install]
WantedBy=default.target
